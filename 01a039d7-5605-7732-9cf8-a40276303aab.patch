+    if raw.get("attribution"):
+        _add_text(sl, 1.4, 5.2, 9.0, 0.5, "— " + _clip(raw["attribution"], 120),
+                  size=15, color=t["dim"])
+    if raw.get("title") and raw["title"] != "Quote":
+        _add_text(sl, 0.9, 1.5, 11.5, 0.6, raw["title"], size=15, color=t["accent"], bold=True)
+    _notes(sl, raw)
+    return sl
