+++ b/aura/js/ui/resizers.js
@@ -0,0 +1,161 @@
+/**
+ * AURA :: Panel Resizers
+ * ======================
+ * Pointer-driven drag handles on the edges of the main layout regions, so
+ * the user can reshape the workspace like any desktop IDE:
+ *
+ *   • left DOCK     — drag its right edge   (width  48 .. 140 px)
+ *   • right PANELS  — drag its left edge    (width 260 .. 720 px)
+ *   • chat COMPOSER — drag its top edge     (height 72 .. 60% viewport)
+ *
+ * Sizes live in CSS custom properties (`--dock-w`, `--panel-w`) plus an
+ * inline height on the composer, and are persisted via config so the layout
+ * survives restarts. Double-clicking a handle snaps back to the default.
+ *
+ * Pure-DOM: no framework, no layout relayout loops — one CSS var write per
+ * pointermove is the entire cost.
+ *
+ * @module ui/resizers
+ */
+import { config } from '../core/config.js';
+import { bus, EV } from '../core/bus.js';
+
+const LIMITS = {
+  dock:     { min: 48,  max: 140, def: 66,  key: 'uiDockWidth',     cssVar: '--dock-w' },
+  panels:   { min: 260, max: 720, def: 400, key: 'uiPanelWidth',    cssVar: '--panel-w' },
+  composer: { min: 72,  max: 0,   def: 0,   key: 'uiComposerHeight' },  // max set per-drag (viewport)
+};
+
+const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));
+
+function el(target) {
+  return typeof target === 'string' ? document.querySelector(target) : target;
+}
+
+/** Build one absolutely-positioned drag handle inside a (now) relative parent. */
+function attach(parent, edge /* 'e' | 'w' | 'n' */, label) {
+  const cs = getComputedStyle(parent);
+  if (cs.position === 'static') parent.style.position = 'relative';
+  const h = document.createElement('div');
+  h.className = `resize-handle resize-handle-${edge}`;
+  h.title = `${label} — drag to resize, double-click to reset`;
+  h.setAttribute('role', 'separator');
+  h.setAttribute('aria-orientation', edge === 'n' ? 'horizontal' : 'vertical');
+  h.setAttribute('aria-label', `Resize ${label}`);
+  parent.appendChild(h);
+  return h;
+}
+
+/**
+ * Core drag driver. Pointer capture keeps tracking even if the cursor
+ * leaves the handle — the "drag and hold" behaviour asked for.
+ */
+function makeDraggable(handle, { axis, startSize, apply, onEnd }) {
+  handle.addEventListener('pointerdown', (e) => {
+    if (e.button !== 0) return;
+    e.preventDefault();
+    const startPos = axis === 'x' ? e.clientX : e.clientY;
+    const startVal = startSize();
+    handle.setPointerCapture(e.pointerId);
+    document.body.classList.add('resizing');
+    handle.classList.add('active');
+    const move = (ev) => {
+      const pos = axis === 'x' ? ev.clientX : ev.clientY;
+      apply(startVal, pos - startPos);
+    };
+    const up = () => {
+      document.body.classList.remove('resizing');
+      handle.classList.remove('active');
+      handle.removeEventListener('pointermove', move);
+      onEnd?.();
+    };
+    handle.addEventListener('pointermove', move);
+    handle.addEventListener('pointerup', up, { once: true });
+    handle.addEventListener('pointercancel', up, { once: true });
+  });
+}
+
+/** Wire all three resizers. Idempotent — safe on hot paths. */
+export function initResizers() {
+  if (initResizers._done) return;
+  initResizers._done = true;
+  const root = document.documentElement;
+
+  /* ── left dock ──────────────────────────────────────────────────── */
+  const dockEl = el('.dock');
+  if (dockEl) {
+    const L = LIMITS.dock;
+    const saved = Number(config.get(L.key));
+    if (saved) root.style.setProperty(L.cssVar, `${clamp(saved, L.min, L.max)}px`);
+    const h = attach(dockEl, 'e', 'sidebar');
+    makeDraggable(h, {
+      axis: 'x',
+      startSize: () => dockEl.getBoundingClientRect().width,
+      apply: (start, d) => {
+        const w = clamp(start + d, L.min, L.max);
+        root.style.setProperty(L.cssVar, `${w}px`);
+        h.dataset.size = w;
+      },
+      onEnd: () => config.set(L.key, Number(h.dataset.size) || null),
+    });
+    h.addEventListener('dblclick', () => {
+      root.style.setProperty(L.cssVar, `${L.def}px`);
+      config.set(L.key, null);
+      bus.emit(EV.UI_TOAST, { type: 'info', text: 'Sidebar width reset.' });
+    });
+  }
+
+  /* ── right panels ───────────────────────────────────────────────── */
+  const panelsEl = el('.panels');
+  if (panelsEl) {
+    const L = LIMITS.panels;
+    const saved = Number(config.get(L.key));
+    if (saved) root.style.setProperty(L.cssVar, `${clamp(saved, L.min, L.max)}px`);
+    const h = attach(panelsEl, 'w', 'panel rail');
+    makeDraggable(h, {
+      axis: 'x',
+      startSize: () => panelsEl.getBoundingClientRect().width,
+      apply: (start, d) => {           // dragging left (−d) widens
+        const w = clamp(start - d, L.min, L.max);
+        root.style.setProperty(L.cssVar, `${w}px`);
+        h.dataset.size = w;
+      },
+      onEnd: () => config.set(L.key, Number(h.dataset.size) || null),
+    });
+    h.addEventListener('dblclick', () => {
+      root.style.setProperty(L.cssVar, `${L.def}px`);
+      config.set(L.key, null);
+      bus.emit(EV.UI_TOAST, { type: 'info', text: 'Panel width reset.' });
+    });
+  }
+
+  /* ── chat composer (drag its top edge upward for a taller box) ──── */
+  const composerEl = el('.composer');
+  if (composerEl) {
+    const L = LIMITS.composer;
+    const saved = Number(config.get(L.key));
+    if (saved) composerEl.style.height = `${saved}px`;
+    const h = attach(composerEl, 'n', 'composer');
+    makeDraggable(h, {
+      axis: 'y',
+      startSize: () => composerEl.getBoundingClientRect().height,
+      apply: (start, d) => {           // dragging up (−d) grows
+        const maxH = Math.max(160, window.innerHeight * 0.6);
+        const hh = clamp(start - d, L.min, maxH);
+        composerEl.style.height = `${hh}px`;
+        h.dataset.size = hh;
+      },
+      onEnd: () => config.set(L.key, Number(h.dataset.size) || null),
+    });
+    h.addEventListener('dblclick', () => {
+      composerEl.style.height = '';
+      config.set(L.key, null);
+      bus.emit(EV.UI_TOAST, { type: 'info', text: 'Composer height reset.' });
+    });
+  }
+}
