+            say(c(31, "  Ollama proxy module unavailable.")); return
+        st = ollama_proxy.status(OLLAMA_BASE)
+        if not st.get("running"):
+            say(c(31, "  Ollama is not running. Start it: ollama serve")); return
+        models = st.get("models", [])
+        if not models:
+            say(c(33, "  No models installed. Run: ollama pull gemma2:2b")); return
+        idx = _cli_pick("Model:",
+                        models,
+                        lambda i, m: f"  [{i+1}] {c(36, m.get('name','?'))}  {m.get('params') or '?'}  {m.get('size_gb') or 0:.1f}G")
+        if idx is None:
+            return
+        _CLI_MODE, _CLI_API = "ollama", None
+        _CLI_MODEL = models[idx]["name"]
+        say(c(32, f"  ◈ Pinned CLI to Ollama: {_CLI_MODEL}"))
+        return
+
+    # API provider branch
+    def prov_row(i, p):
+        has = bool(_cli_vault_key(p["id"]))
+        mark = c(32, "✓ key saved") if has else c(31, "✗ no key")
+        return f"  [{i+1}] {c(36, p['label'])}  {mark}"
+    pi = _cli_pick("Provider [1-5]:", CLI_API_PROVIDERS, prov_row)
+    if pi is None:
+        return
+    prov = CLI_API_PROVIDERS[pi]
+    key = _cli_vault_key(prov["id"])
+    if not key:
+        say(c(31, f"\n  No API key stored for {prov['label']}."))
+        say(c(37,  "  How to add one (30 seconds):"))
+        say(       "    1. Open the AURA app → Settings → API Keys")
+        say(f"    2. Paste your {prov['label']} key → Save (lands in the vault DB)")
+        say(       "    3. Come back here — /model picks it up automatically")
+        say(c(37, f"  ({prov['label']} gives free keys — e.g. aistudio.google.com/apikey for Gemini)"))
+        return
+    models = list(prov["models"])
+    live = _cli_list_api_models(prov, key)
+    if live:
+        for m in live:
+            if m not in models:
+                models.append(m)
+    mi = _cli_pick("Model:",
+                   models,
+                   lambda i, m: f"  [{i+1}] {c(36, m)}" + (c(37, "  (default)") if i == 0 else ""))
+    if mi is None:
+        return
+    _CLI_MODE = "api"
+    _CLI_API = {"provider": prov["id"], "model": models[mi], "label": prov["label"]}
+    say(c(32, f"  ◈ CLI now talks to {prov['label']} ({models[mi]}) — key loaded from the vault DB"))
+
+
+def _cli_list_api_models(prov, key):
+    """Best-effort live model listing; [] on any failure (menu falls back to defaults)."""
+    import urllib.request
+    try:
+        if prov["kind"] == "gemini":
+            req = urllib.request.Request(f"{prov['base']}/models?key={urllib.parse.quote(key)}")
+            j = json.loads(urllib.request.urlopen(req, timeout=8).read())
+            return [m["name"].replace("models/", "") for m in j.get("models", [])
+                    if "gemini" in m.get("name", "")][:12]
+        if prov["kind"] == "openai-compat":
+            req = urllib.request.Request(f"{prov['base']}/models",
+                                         headers={"Authorization": f"Bearer {key}"})
+            j = json.loads(urllib.request.urlopen(req, timeout=8).read())
+            return sorted(m["id"] for m in j.get("data", []))[:12]
+    except Exception:
+        pass
+    return []
+
+
+_CLI_DOC_SCHEMAS = {
+    "pptx": '{"title":"...","subtitle":"...","slides":[{"title":"...","bullets":["point","point"]}, ...]}',
+    "xlsx": '{"title":"...","sheets":[{"name":"...","columns":["col","col"],"rows":[["v","v"], ...]}]}',
+    "docx": '{"title":"...","subtitle":"...","sections":[{"heading":"...","level":1,"paragraphs":["..."],"bullets":["..."]}, ...]}',
+}
+
+
+def _cli_complete_json(messages, max_tokens=4096):
+    """
+    One non-streaming JSON request to the CLI's SELECTED backend (/model).
+    Returns (parsed_or_None, info_string, raw_text).
+    """
+    collected = []
+    if _CLI_MODE == "api" and _CLI_API:
+        prov = next((p for p in CLI_API_PROVIDERS if p["id"] == _CLI_API["provider"]), None)
+        key = _cli_vault_key(prov["id"]) if prov else None
+        if not (prov and key):
+            return None, f"{_CLI_API.get('label','?')}: no key in vault", ""
+        err = _cli_api_stream(prov, _CLI_API["model"], key, messages, collected.append)
+        raw = "".join(collected)
+        if err:
+            return None, f"{prov['label']}: {err.splitlines()[0]}", raw
+        src = f"{prov['label']} ({_CLI_API['model']})"
+    else:
+        if not ollama_proxy:
+            return None, "Ollama module missing", ""
+        st = ollama_proxy.status(OLLAMA_BASE)
+        if not st.get("running") or not st.get("models"):
+            return None, "Ollama not running", ""
+        model, _ = _get_cli_model_info()
+        try:
+            body = json.dumps({"model": model, "messages": messages, "stream": False,
+                               "options": {"temperature": 0.45, "num_predict": max_tokens}}).encode()
+            req = urllib.request.Request(OLLAMA_BASE + "/api/chat", data=body,
+                                         headers={"Content-Type": "application/json"})
+            raw = json.loads(urllib.request.urlopen(req, timeout=120).read()) \
+                .get("message", {}).get("content", "")
+            src = f"Ollama ({model})"
+        except Exception as e:
+            return None, f"Ollama: {e}", ""
+    # Lenient extract: first balanced {...}
+    i = raw.find("{")
+    depth = 0
+    in_str = esc = False
+    q = ""
+    for j in range(max(0, i), len(raw)):
+        ch = raw[j]
+        if esc: esc = False; continue
+        if ch == "\\": esc = True; continue
+        if in_str:
+            if ch == q: in_str = False
+            continue
+        if ch in ("\"", "'"): in_str, q = True, ch
+        elif ch == "{": depth += 1
+        elif ch == "}":
+            depth -= 1
+            if depth == 0:
+                try:
+                    return json.loads(raw[i:j+1]), src, raw
+                except Exception:
+                    break
+    return None, f"{src}: reply was not usable JSON ({len(raw)} chars)", raw
+
+
+def _cli_doc_spec(kind, topic, slides=0, guidance=""):
+    """
+    Ask the SELECTED backend to outline the document, mirroring the app's
+    prompt shape. Returns (spec_or_None, info, used_model_bool).
+    """
+    schema = _CLI_DOC_SCHEMAS[kind]
+    n = slides or {"pptx": 8, "xlsx": 1, "docx": 4}[kind]
+    sys_p = ("You are a world-class document outliner. Reply with ONE JSON object "
+             "and nothing else — no prose, no markdown fence, no explanation.")
+    lines = [
+        f"Create a {kind.upper()} outline as JSON with EXACTLY this shape:",
+        schema,
+        f"Topic: {topic}",
+        (f"Requested size: ~{n} {'slides' if kind == 'pptx' else 'sheets/sections'}." if n else ""),
+        (f"Extra information to incorporate (from the user): {guidance}" if guidance else ""),
+        "Rules: content must be specific and insightful about the topic — generic filler "
+        "('important factors', 'various aspects') is a failure. No empty slides/rows.",
+    ]
+    spec, info, raw = _cli_complete_json(
+        [{"role": "system", "content": sys_p}, {"role": "user", "content": "\n".join(l for l in lines if l)}])
+    if not spec or not isinstance(spec, dict):
+        return None, info, False
+    box = {"pptx": "slides", "xlsx": "sheets", "docx": "sections"}[kind]
+    if not isinstance(spec.get(box), list) or not spec[box]:
+        return None, f"{info}: JSON parsed but had no {box}[]", False
+    return spec, info, True
+
+
+def _cli_template_spec(kind, topic):
