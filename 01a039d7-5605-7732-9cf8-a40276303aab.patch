+/**
+ * NOVA :: doc-path model resilience
+ * =================================
+ * Reproduces the report that started this fix ("always: Model returned no
+ * usable JSON — built a skeleton instead" even with Ollama + API keys
+ * configured) against the repaired router, with injected streams —
+ * no browser, no network, no model.
+ *
+ * Proves:
+ *   A. failures are CLASSIFIED with evidence (EMPTY / prose / CUT OFF),
+ *      and the old catch-all phrase is gone
+ *   B. a genuinely failing selected backend escalates to other configured
+ *      backends — disclosed via via:'fallback*' — so decks stop dying
+ *      while any working provider exists
+ *   C. the Ollama adapter actually sends num_predict, so long deck-JSON
+ *      is not truncated mid-stream
+ *
+ *   node tests/test-doc-resilience.mjs
+ */
+import * as router from '../js/ai/router.js';
+import { ollama } from '../js/ai/providers.js';
+import { config } from '../js/core/config.js';
+
+let P = 0, F = 0;
+const ok = (n, c, d = '') => {
+  if (c) { P++; console.log(`  \x1b[32m✓\x1b[0m ${n}`); }
+  else { F++; console.log(`  \x1b[31m✗\x1b[0m ${n}${d ? `  \x1b[90m${d}\x1b[0m` : ''}`); }
+};
+const S = (t) => console.log(`\n\x1b[36m▸ ${t}\x1b[0m`);
+
+const gen = (...chunks) => async function* () { for (const c of chunks) yield c; };
+const nothing = async function* () {};
+const DECK = { title: 'Fats', slides: [{ title: 'Overview', bullets: ['one', 'two'] }] };
+
+config.data.provider = 'auto';
+config.data.apiKeys = { gemini: 'gk', openai: 'ok' };
+
+/* ─────────────────────────────────────────────────────────── */
+S('A. CLASSIFIED DIAGNOSTICS — the vague catch-all is retired');
+{
+  const eng = { resolvedProvider: 'gemini', resolvedModel: 'gemini-2.5-flash' };
+
+  let r = await router.completeJSON({ messages: [{ role: 'user', content: 'x' }],
+                                      engine: eng, streamFn: nothing, retries: 0 });
+  ok('empty stream → classified EMPTY + backend named',
+     !r.ok && /EMPTY/.test(r.message) && /gemini/.test(r.message), r.message.slice(0, 100));
+  ok('old catch-all phrase is gone',
+     !/no usable JSON/i.test(r.message), r.message.slice(0, 60));
+
+  r = await router.completeJSON({ messages: [{ role: 'user', content: 'x' }], engine: eng,
+                                  streamFn: gen('Sure! Here is a lovely outline, no JSON today.'),
+                                  retries: 0 });
+  ok('prose reply → classified + evidence snippet',
+     !r.ok && /prose, not JSON/i.test(r.message) && r.message.includes('Sure!'),
+     r.message.slice(0, 120));
+
+  r = await router.completeJSON({ messages: [{ role: 'user', content: 'x' }], engine: eng,
+                                  streamFn: gen('{"title":"D","slides":[{"title":"A","bullets":["one","two"]},{"title":"B"'),
+                                  retries: 0 });
+  ok('truncated JSON → classified "cut off" + token-cap hint',
+     !r.ok && /CUT OFF/i.test(r.message), r.message.slice(0, 120));
+
+  r = await router.completeJSON({ messages: [{ role: 'user', content: 'x' }], engine: eng,
+                                  streamFn: gen('```json\n' + JSON.stringify(DECK) + '\n```'),
+                                  retries: 0 });
+  ok('valid fenced JSON parses via the selected backend',
+     r.ok && r.json.title === 'Fats' && r.provider === 'gemini' && r.via === 'selected',
+     JSON.stringify({ ok: r.ok, via: r.via, provider: r.provider }));
+}
+
+/* ─────────────────────────────────────────────────────────── */
+S('B. ESCALATION — any working backend rescues the deck, disclosed');
+{
+  const eng = { resolvedProvider: 'gemini', resolvedModel: 'gemini-2.5-flash' };
+
+  let calls = 0;
+  const flakyThenGood = async function* () { calls++; if (calls >= 3) yield JSON.stringify(DECK); };
+  let r = await router.completeJSON({ messages: [{ role: 'user', content: 'x' }],
+                                      engine: eng, streamFn: flakyThenGood, retries: 0 });
+  ok('gemini + openai dead → ollama finishes the deck',
+     r.ok && r.provider === 'ollama' && r.via === 'fallback-local' && calls === 3,
+     JSON.stringify({ ok: r.ok, provider: r.provider, via: r.via, calls }));
+  ok('fallback is disclosed, never hidden', r.via !== 'selected', r.via);
+
+  calls = 0;
+  const alwaysDead = async function* () { calls++; };
+  r = await router.completeJSON({ messages: [{ role: 'user', content: 'x' }], engine: eng,
+                                  streamFn: alwaysDead, retries: 0, escalate: false });
+  ok('escalate:false pins strictly to the UI selection', !r.ok && calls === 1, `calls=${calls}`);
+
+  const ct = router.candidateTargets(eng);
+  ok('candidates: selected first, capped at 3, fallback roles tagged',
+     ct[0].id === 'gemini' && ct[0].via === 'selected' && ct.length === 3
+       && ct[1].via === 'fallback' && ct[2].id === 'ollama',
+     ct.map(t => `${t.id}:${t.via}`).join(','));
+
+  config.data.apiKeys = {};
+  const ct2 = router.candidateTargets({ resolvedProvider: 'ollama', resolvedModel: 'q' });
+  ok('no keys configured → only the resolved local backend', ct2.length === 1 && ct2[0].id === 'ollama',
+     ct2.map(t => t.id).join(','));
+  config.data.apiKeys = { gemini: 'gk', openai: 'ok' };
+}
+
+/* ─────────────────────────────────────────────────────────── */
+S('C. OLLAMA — num_predict reaches the wire (long JSON survives)');
+{
+  ollama.__proxy = false;                     // skip the server probe
+  ollama.installed = ['qwen2.5:3b'];
+  ollama._discoveredAt = Date.now();          // fresh cache → refresh() needs no fetch
+  const captured = [];
+  const realFetch = globalThis.fetch;
+  globalThis.fetch = async (url, opts) => {
+    captured.push({ url: String(url), body: opts?.body ? JSON.parse(opts.body) : null });
+    const chunk = new TextEncoder().encode(
+      '{"message":{"content":"hi"},"done":false}\n{"message":{"content":"!"},"done":true}\n');
+    const rs = new ReadableStream({ start(c) { c.enqueue(chunk); c.close(); } });
+    return { ok: true, headers: { get: () => null }, body: { getReader: () => rs.getReader() } };
+  };
+
+  let text = '';
+  for await (const d of ollama.stream({ messages: [{ role: 'user', content: 'hi' }],
+                                        model: 'qwen2.5:3b', maxTokens: 4096, temperature: 0.5 })) text += d;
+  const chat1 = captured.find(c => c.url.includes('/api/chat'));
+  ok('NDJSON deltas assemble into full text', text === 'hi!', JSON.stringify(text));
+  ok('requested budget 4096 → num_predict 4096 on the wire',
+     chat1?.body?.options?.num_predict === 4096, JSON.stringify(chat1?.body?.options));
+
+  for await (const _ of ollama.stream({ messages: [{ role: 'user', content: 'hi' }],
+                                        model: 'qwen2.5:3b', temperature: 0.5 })) { /* drain */ }
+  const chat2 = captured.filter(c => c.url.includes('/api/chat')).pop();
+  ok('no budget requested → unlimited (-1), chat behaviour unchanged',
+     chat2?.body?.options?.num_predict === -1, JSON.stringify(chat2?.body?.options));
+
+  globalThis.fetch = realFetch;
+}
+
+/* ─────────────────────────────────────────────────────────── */
+S('D. NO BACKEND → actionable guidance, not a silent skeleton');
+{
+  const bk = await router.usableBackend({ resolvedProvider: 'gemini', resolvedModel: 'x' });
+  ok('keyed provider counts as usable', bk.kind === 'keyed' && bk.provider === 'gemini',
+     JSON.stringify(bk));
+
+  config.data.apiKeys = {};
+  ollama.__proxy = false;
+  const realFetch = globalThis.fetch;
+  globalThis.fetch = async () => { throw new Error('connect ECONNREFUSED 127.0.0.1:11434'); };
+
+  const none = await router.usableBackend(null);
+  ok('no keys + ollama down → usableBackend reports none', none.kind === 'none', JSON.stringify(none));
+
+  const { outline } = await import('../js/ai/doc-agent.js');
+  const r = await outline({ kind: 'pptx', topic: 'fats',
+                            engine: { resolvedProvider: 'local', resolvedModel: '' } });
+  ok('/doc says no API key is stored', r.source === 'offline-template' && /no api key is stored/i.test(r.message || ''),
+     (r.message || '').slice(0, 80));
+  ok('…and says HOW to fix it (Settings key / ollama serve)',
+     /Settings/.test(r.message || '') && /ollama serve/i.test(r.message || ''), (r.message || '').slice(-90, ));
+
+  globalThis.fetch = realFetch;
+  config.data.apiKeys = { gemini: 'gk', openai: 'ok' };
+}
+
+console.log(`\n${'─'.repeat(56)}`);
+console.log(`  \x1b[32mPASS ${P}\x1b[0m   ${F ? `\x1b[31mFAIL ${F}\x1b[0m` : 'FAIL 0'}`);
+if (F) process.exit(1);
