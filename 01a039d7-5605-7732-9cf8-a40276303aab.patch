+    if kind == "xlsx":
+        return {
+            "title": f"{topic.title()} Summary",
+            "sheets": [{
+                "name": "Summary",
+                "columns": ["Item / Metric", "Category", "Baseline", "Target", "Status", "Notes"],
+                "rows": [
