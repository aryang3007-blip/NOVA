{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": [],
    "paths": {
      "*/three.module.js": [
        "./types/external.d.ts"
      ],
      "*/vision_bundle.mjs": [
        "./types/external.d.ts"
      ],
      "https://cdn.jsdelivr.net/npm/three@0.169.0/build/three.module.js": [
        "./types/external.d.ts"
      ],
      "https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/vision_bundle.mjs": [
        "./types/external.d.ts"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "js/**/*.js",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "vendor",
    "tests",
    "**/*.min.js"
  ]
}